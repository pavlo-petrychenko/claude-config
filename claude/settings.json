          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__agent-plan-review__plan_review_check",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/pavlopetricenko/.claude/hooks/herdr-status.mjs hook PostToolUse",
