{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CTO_REVIEW_GATE": "off",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "64"
  },
  "permissions": {
    "allow": [],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/pavlopetricenko/.local/bin/conveyor hook Notification"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/pavlopetricenko/.local/bin/conveyor hook PermissionRequest"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/pavlopetricenko/.bun/bin/bun /Users/pavlopetricenko/Documents/personal/cc-memory/dist/memory.js hook compact-checkpoint",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/pavlopetricenko/.claude/hooks/herdr-status.mjs plan-review start; AGENT_PLAN_REVIEW_TIMEOUT=10800 node /Users/pavlopetricenko/Documents/personal/agent-plan-review/bin/agent-plan-review.js hook-exit-plan-mode; rc=$?; node /Users/pavlopetricenko/.claude/hooks/herdr-status.mjs plan-review end; exit $rc",
            "timeout": 10800
          }
        ]
      },
      {
        "matcher": "EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/pavlopetricenko/Documents/personal/agent-plan-review/bin/agent-plan-review.js enter-plan-mode",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/pavlopetricenko/.claude/hooks/herdr-status.mjs hook PreToolUse",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__agent-plan-review__plan_review_check",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/pavlopetricenko/.claude/hooks/herdr-status.mjs hook PreToolUse",
